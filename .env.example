# Copy to .env and fill in. .env is git-ignored - never commit a key.

# Your personal course key (course portal -> Profile -> API key) and the class proxy.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://llm.nat-d.uk/v1

CHAT_MODEL=gemma-4-E4B-it
EMBED_MODEL=bge-m3

# Retrieval - the configuration the evaluation found best (see README, "Results").
# Baseline for comparison (the reference app's defaults): CHUNKING=naive:800:150 RETRIEVAL=dense TOP_K=5 MIN_SCORE=0.40
CHUNKING=naive:800:150
RETRIEVAL=hybrid
MIN_SCORE=0.55
TOP_K=10
# System prompt version: v1 (default) or v2 (adds a routing rule; mixed results, see README)
PROMPT=v1

# Hard cap on the agent loop (tool calls before it must answer).
MAX_STEPS=5
