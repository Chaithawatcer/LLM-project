# Copy to .env and fill in. .env is git-ignored - never commit a key.

# Your personal course key (course portal -> Profile -> API key) and the class proxy.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://llm.nat-d.uk/v1

CHAT_MODEL=gemma-4-E4B-it
EMBED_MODEL=bge-m3

# Retrieval. These defaults are the BASELINE the evaluation compares against
# (fixed 800-char windows, dense search, the reference app's 0.40 floor).
# After `uv run python -m eval.run_eval ...` set the values it recommends:
CHUNKING=naive:800:150
RETRIEVAL=dense
MIN_SCORE=0.40
TOP_K=5

# Hard cap on the agent loop (tool calls before it must answer).
MAX_STEPS=5
